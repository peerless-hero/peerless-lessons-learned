---
import OpenSourceContributionCard from '@components/OpenSourceContributionCard.astro'
import { Icon } from 'astro-icon/components'
import { getConstants } from '@consts'
import BaseLayout from '@layouts/BaseLayout.astro'
import { contributions, openSourceMeta, overviewStats } from '@utils/en/opensource'

const currentLocale = 'en'
const constants = getConstants(currentLocale)

const title = `Open Source Contributions - ${constants.SITE_TITLE}`
const description =
  'Open source contributions by peerless-hero: merged pull requests to external public repositories such as LobeHub, CubeSandbox, unplugin-auto-import and showdoc, with a data snapshot and a list sorted by merge date.'

// Structured data (SEO): breadcrumb navigation + contributor + contributed repositories
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Open Source Contributions',
          item: pageUrl.toString(),
        },
      ],
    },
    {
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: 'peerless-hero',
        alternateName: '无双（peerless-hero）',
        url: openSourceMeta.accountUrl,
        sameAs: [openSourceMeta.accountUrl],
        description: 'Open source contributor profile of peerless-hero',
      },
      name: 'Open Source Contributions',
      url: pageUrl.toString(),
      description,
    },
    {
      '@type': 'ItemList',
      name: 'Open Source Contributions',
      description: 'Merged pull requests by peerless-hero across external public repositories.',
      itemListElement: contributions.map((c, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: c.repoUrl,
        name: c.repo,
      })),
    },
  ],
}
---

<BaseLayout title={title} description={description} image="/screenshot.webp">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <section class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Open Source Contributions
      </p>
      <h1 class="mt-2 text-3xl font-bold text-neutral-900 sm:text-4xl dark:text-white">Open Source Contributions</h1>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
        <a
          href={openSourceMeta.accountUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 py-2 font-medium text-neutral-700 transition-colors hover:border-sky-400 hover:text-sky-600 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:border-sky-500 dark:hover:text-sky-400"
        >
          <Icon name="tabler:brand-github" class="inline-block size-4 shrink-0 align-bottom" />
          github.com/{openSourceMeta.account}
        </a>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-100 px-4 py-2 font-medium text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400"
        >
          <Icon name="tabler:calendar" class="inline-block size-4 shrink-0 align-bottom" />
          Snapshot {openSourceMeta.collectedAt}
        </span>
      </div>
    </section>

    {/* Overview */}
    <section class="mt-12">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          overviewStats.map((stat) => (
            <div class="rounded-2xl border border-neutral-200 bg-white p-6 text-center dark:border-neutral-700 dark:bg-neutral-800">
              <p class="text-3xl font-bold text-neutral-900 sm:text-4xl dark:text-white">{stat.value}</p>
              <p class="mt-2 text-xs leading-relaxed text-neutral-500 sm:text-sm dark:text-neutral-400">{stat.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-neutral-400 dark:text-neutral-500">
        Queried via GitHub GraphQL (states: MERGED) and cross-checked with the gh CLI; covers all history.
      </p>
    </section>

    {/* Contribution list */}
    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">Contributions</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
            {contributions.length} items, sorted by merge date (newest first)
          </p>
        </div>
      </div>
      <OpenSourceContributionCard contributions={contributions} lang="en" />
    </section>
  </main>
</BaseLayout>
