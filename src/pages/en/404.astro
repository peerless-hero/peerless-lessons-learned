---
import { getConstants } from '@consts'
import BaseLayout from '@layouts/BaseLayout.astro'
import { Icon } from 'astro-icon/components'
import { getRelativeLocaleUrl } from 'astro:i18n'

const currentLocale = 'en'
const constants = getConstants(currentLocale)

function safeGetRelativeLocaleUrl(path: string) {
  return getRelativeLocaleUrl(currentLocale, path)
}
---

<BaseLayout title={constants.ERROR_404_TITLE} description={constants.ERROR_404_DESCRIPTION}>
  <main id="content">
    <div class="px-4 py-10 text-center lg:px-8 sm:px-6">
      <h1 class="block text-7xl text-neutral-800 font-bold sm:text-9xl dark:text-white">404</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        {constants.ERROR_404_MESSAGE}
      </p>
      <p class="text-neutral-600 dark:text-neutral-400">
        {constants.ERROR_404_SUBMESSAGE}
      </p>
      <div class="mt-5 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-3">
        <a
          class="w-full inline-flex items-center justify-center gap-x-2 border border-transparent rounded-lg bg-neutral-400 px-4 py-3 text-sm text-white font-semibold disabled:pointer-events-none sm:w-auto hover:bg-neutral-600 disabled:opacity-50"
          href={safeGetRelativeLocaleUrl('/')}
        >
          <Icon name="tabler:chevron-left" class="icon-base" />
          {constants.GO_TO_HOMEPAGE}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
