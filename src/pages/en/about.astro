---
import LatestPosts from '@components/LatestPosts.astro'
import { Picture } from 'astro:assets'
import { getConstants } from '@consts'
import BaseLayout from '@layouts/BaseLayout.astro'
import { Icon } from 'astro-icon/components'

import codingDeveloper from 'src/assets/coding-developer.jpg'
import techCode from 'src/assets/tech-code.jpg'
import hikingAdventure from 'src/assets/hiking-adventure.jpg'

const currentLocale = 'en'
const constants = getConstants(currentLocale)

const title = `About ${constants.SITE_TITLE}`
const description = constants.SITE_DESCRIPTION
const tabs = [
  {
    icon: 'tabler:star',
    title: 'Heavenly Stems',
    content:
      'Heavenly Stems represent the timing of the heavens, symbolizing the passage of time and the arrangement of destiny. Each Heavenly Stem is a unique energy symbol, guiding us to find our direction in the flow of time.',
    image: codingDeveloper,
    imageAlt: 'About the Astral World - Heavenly Stems',
  },
  {
    icon: 'tabler:leaf',
    title: 'Earthly Branches',
    content:
      'Earthly Branches symbolize the power of the earth and the operation of human affairs. The combination of Earthly Branches forms the framework of time and space, allowing us to find stability amidst change.',
    image: techCode,
    imageAlt: 'About the Astral World - Earthly Branches',
  },
  {
    icon: 'tabler:yin-yang',
    title: 'Yin and Yang',
    content:
      'Yin and Yang are the fundamental laws of the universe, representing opposition and unity. The balance of Yin and Yang allows all things to thrive, teaching us to maintain harmony and balance in life.',
    image: hikingAdventure,
    imageAlt: 'About the Astral World - Yin and Yang',
  },
]
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-[85rem] px-4 py-10 lg:px-8 lg:py-14 sm:px-6">
    <div class="relative p-6 md:p-16">
      <div class="relative z-10 lg:grid lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="mb-10 lg:order-2 lg:col-span-6 lg:col-start-8 lg:mb-0">
          <h2 class="text-2xl text-neutral-800 font-bold sm:text-3xl dark:text-neutral-200">
            {description}
          </h2>

          <nav class="grid mt-5 gap-4 md:mt-10" aria-label="Tabs" role="tablist" aria-orientation="vertical">
            {
              tabs.map((tab, index) => (
                <button
                  type="button"
                  class={`rounded-xl p-4 text-start focus:bg-neutral-200 hover:bg-neutral-200 hs-tab-active:bg-white md:p-5 hs-tab-active:shadow-md focus:outline-none hs-tab-active:hover:border-transparent dark:focus:bg-neutral-700 dark:hover:bg-neutral-700 dark:hs-tab-active:bg-neutral-700 ${index === 0 ? 'active' : ''}`}
                  id={`tabs-with-card-item-${index + 1}`}
                  data-hs-tab={`#tabs-with-card-${index + 1}`}
                  aria-controls={`tabs-with-card-${index + 1}`}
                  role="tab"
                >
                  <span class="flex gap-x-6">
                    <Icon
                      name={tab.icon}
                      class="mt-2 size-6 shrink-0 text-neutral-800 md:size-7 dark:text-neutral-200 hs-tab-active:text-neutral-600 dark:hs-tab-active:text-neutral-500"
                    />
                    <span class="grow">
                      <span class="block text-lg text-neutral-800 font-semibold dark:text-neutral-200 hs-tab-active:text-neutral-600 dark:hs-tab-active:text-neutral-500">
                        {tab.title}
                      </span>
                      <span class="mt-1 block text-neutral-800 dark:text-neutral-200 dark:hs-tab-active:text-neutral-200">
                        {tab.content}
                      </span>
                    </span>
                  </span>
                </button>
              ))
            }
          </nav>
        </div>

        <div class="lg:col-span-6">
          <div class="relative">
            <div>
              {
                tabs.map((tab, index) => (
                  <div
                    id={`tabs-with-card-${index + 1}`}
                    class={index === 0 ? '' : 'hidden'}
                    role="tabpanel"
                    aria-labelledby={`tabs-with-card-item-${index + 1}`}
                  >
                    <Picture
                      src={tab.image}
                      alt={tab.imageAlt}
                      width={600}
                      height={420}
                      widths={[320, 480, 600]}
                      sizes="(max-width: 640px) 320px, (max-width: 1024px) 480px, 600px"
                      formats={['avif']}
                      fallbackFormat="avif"
                      class="rounded-xl object-cover shadow-neutral-200 shadow-xl dark:shadow-neutral-900/20 w-[320px] sm:w-[480px] lg:w-[600px] h-[420px]"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="absolute inset-0 grid grid-cols-12 size-full">
        <div
          class="col-span-full h-5/6 w-full rounded-xl bg-neutral-100 lg:col-span-7 lg:col-start-6 lg:h-full sm:h-3/4 dark:bg-neutral-800"
        >
        </div>
      </div>
    </div>
  </div>
  <LatestPosts currentLocale={currentLocale} />
</BaseLayout>
