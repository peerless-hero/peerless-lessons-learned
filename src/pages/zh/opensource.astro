---
import OpenSourceContributionCard from '@components/OpenSourceContributionCard.astro'
import { Icon } from 'astro-icon/components'
import { getConstants } from '@consts'
import BaseLayout from '@layouts/BaseLayout.astro'
import { contributions, openSourceMeta } from '@utils/zh/opensource'

const currentLocale = 'zh'
const constants = getConstants(currentLocale)

const title = `开源贡献 - ${constants.SITE_TITLE}`
const description =
  '无双（peerless-hero）的开源贡献页：向 LobeHub、CubeSandbox、unplugin-auto-import、showdoc 等 GitHub 外部公开项目提交 PR 并被合并，附数据快照与按时间倒序的贡献清单。'

// 结构化数据（SEO）：面包屑导航 + 贡献者 + 贡献仓库列表
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '首页',
          item: new URL('/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: '开源贡献',
          item: pageUrl.toString(),
        },
      ],
    },
    {
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: '无双（peerless-hero）',
        alternateName: 'peerless-hero',
        url: openSourceMeta.accountUrl,
        sameAs: [openSourceMeta.accountUrl],
        description: '无双（peerless-hero）的开源贡献者主页',
      },
      name: '开源贡献',
      url: pageUrl.toString(),
      description,
    },
    {
      '@type': 'ItemList',
      name: '开源贡献清单',
      description: '无双（peerless-hero）已合并的外部仓库 Pull Request 贡献。',
      itemListElement: contributions.map((c, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: c.repoUrl,
        name: c.repo,
      })),
    },
  ],
}
---

<BaseLayout title={title} description={description} image="/screenshot.webp">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <main class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- 页头 -->
    <section class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Open Source Contributions
      </p>
      <h1 class="mt-2 text-3xl font-bold text-neutral-900 sm:text-4xl dark:text-white">开源贡献</h1>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
        <a
          href={openSourceMeta.accountUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 py-2 font-medium text-neutral-700 transition-colors hover:border-sky-400 hover:text-sky-600 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:border-sky-500 dark:hover:text-sky-400"
        >
          <Icon name="tabler:brand-github" class="inline-block size-4 shrink-0 align-bottom" />
          github.com/{openSourceMeta.account}
        </a>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-100 px-4 py-2 font-medium text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400"
        >
          <Icon name="tabler:calendar" class="inline-block size-4 shrink-0 align-bottom" />
          数据快照 {openSourceMeta.collectedAt}
        </span>
      </div>
    </section>

    <!-- 贡献列表 -->
    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">贡献列表</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
            共 {contributions.length} 条，按合并时间倒序排列
          </p>
        </div>
      </div>
      <OpenSourceContributionCard contributions={contributions} />
    </section>
  </main>
</BaseLayout>
