---
import FormattedDate from '@components/FormattedDate.astro'
import OptimizedCover from '@components/OptimizedPicture.astro'
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

const currentLocale = Astro.currentLocale ?? 'zh'

const allPosts = await getCollection('posts', ({ id }) => {
  return id.startsWith(`${currentLocale === 'zh' ? 'cn' : 'us'}/`)
})

allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())

const latestPosts = allPosts.slice(0, 3)

function safeGetRelativeLocaleUrl(path: string) {
  return getRelativeLocaleUrl(currentLocale, path)
}
---

<div class="mx-auto max-w-[85rem] px-4 py-4 lg:px-6 lg:py-8 sm:px-4">
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {
      latestPosts.map((post) => (
        <div class="relative mb-4 overflow-hidden rounded-xl bg-white transition-transform duration-500 hover:scale-105 dark:bg-neutral-900 hover:-translate-y-1">
          <a href={safeGetRelativeLocaleUrl(`posts/${post.id}`)}>
            <OptimizedCover src={post.data.cover} alt={post.data.coverAlt} />
            <div class="absolute end-0 start-0 bottom-0 p-4 bg-gradient-to-t md:p-5">
              <div class="mt-16 flex items-center gap-4 text-xs text-white">
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="inline-flex items-center gap-1">
                    {post.data.tags.slice(0, 2).map((tag: string, i: number) => (
                      <span class="inline-flex items-center">
                        {tag}
                        {i < Math.min(post.data.tags.length, 2) - 1 && <span class="ml-1">,</span>}
                      </span>
                    ))}
                    {post.data.tags.length > 2 && <span class="opacity-60">+{post.data.tags.length - 2}</span>}
                  </span>
                )}
                <FormattedDate date={post.data.pubDate} />
              </div>
              <h2 class="mt-2 text-lg text-white font-bold">{post.data.title}</h2>
            </div>
          </a>
        </div>
      ))
    }
  </div>
</div>
