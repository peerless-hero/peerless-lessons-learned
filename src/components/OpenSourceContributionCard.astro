---
import type { ContributionItem } from '@utils/zh/opensource'
import { Icon } from 'astro-icon/components'

interface Props {
  contributions: ContributionItem[]
  lang?: 'zh' | 'en'
}

const { contributions, lang = 'zh' } = Astro.props
const smallIcon = 'inline-block size-3.5 shrink-0 align-bottom'
const labels =
  lang === 'en'
    ? { starTitle: 'GitHub Stars (snapshot)', mergedOn: 'Merged on', diff: 'Diff' }
    : { starTitle: 'GitHub Star（采集时点快照）', mergedOn: '合并于', diff: '规模' }
---

<div class="mt-6 space-y-6">
  {
    contributions.map((c) => (
      <article class="flex flex-col rounded-2xl border border-neutral-200 border-t-4 border-t-sky-400 bg-white p-6 md:p-8 dark:border-neutral-700 dark:bg-neutral-800">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <h3 class="break-words text-xl font-bold text-neutral-900 dark:text-white">
              <a
                href={c.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-sky-600 dark:hover:text-sky-400"
              >
                {c.repo}
              </a>
            </h3>
            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-0.5 font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                <Icon name="tabler:code" class={smallIcon} />
                {c.language}
              </span>
              {c.downloads && (
                <span class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-0.5 font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                  <Icon name="tabler:download" class={smallIcon} />
                  npm {c.downloads}
                </span>
              )}
            </div>
          </div>

          <div
            class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-sm font-semibold text-neutral-700 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-200"
            title={labels.starTitle}
          >
            <Icon name="tabler:star" class="inline-block size-4 shrink-0 align-bottom text-amber-500" />
            {c.stars}
          </div>
        </div>

        <p class="mt-4 leading-relaxed text-neutral-700 dark:text-neutral-300">{c.summary}</p>

        <ul class="mt-5 space-y-2.5">
          {c.prs.map((pr) => (
            <li>
              <a
                href={pr.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl border border-neutral-200 bg-neutral-50 p-4 transition-colors hover:border-sky-400 dark:border-neutral-600 dark:bg-neutral-900 dark:hover:border-sky-500"
              >
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                  <span class="inline-flex shrink-0 items-center rounded-md border border-neutral-300 bg-white px-2 py-0.5 font-mono text-xs font-semibold text-neutral-700 dark:border-neutral-500 dark:bg-neutral-800 dark:text-neutral-200">
                    #{pr.number}
                  </span>
                  <span class="min-w-0 break-words text-sm font-medium text-neutral-800 group-hover:text-sky-700 dark:text-neutral-200 dark:group-hover:text-sky-300">
                    {pr.title}
                  </span>
                </div>
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="tabler:git-merge" class={smallIcon} />
                    {labels.mergedOn} {pr.mergedAt}
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="tabler:file-diff" class={smallIcon} />
                    {labels.diff} {pr.scale}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        {c.highlights.length > 0 && (
          <ul class="mt-5 list-disc space-y-2 pl-5 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300 marker:text-neutral-300 dark:marker:text-neutral-600">
            {c.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>
