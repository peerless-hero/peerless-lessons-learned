---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@components/FormattedDate.astro'
import OptimizedCover from '@components/OptimizedPicture.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const currentLocale = post.id.startsWith('us/') ? 'en' : 'zh'
---

<div
  class="relative overflow-hidden border rounded-xl bg-white transition-transform duration-500 md:flex md:flex-row hover:scale-105 dark:border-neutral-600 dark:bg-neutral-900 hover:-translate-y-1"
>
  <a href={getRelativeLocaleUrl(currentLocale, `posts/${post.id}`)} class="block md:flex md:flex-1">
    <div class="hero-cover md:w-2/3 md:max-h-[420px] flex items-center justify-center rounded-lg overflow-hidden">
      <OptimizedCover src={post.data.cover} alt={post.data.coverAlt} />
    </div>
    <div
      class="absolute end-0 start-0 bottom-0 from-black p-4 bg-gradient-to-t md:relative md:w-1/3 md:flex md:flex-col md:justify-start md:p-5 md:bg-transparent"
    >
      <div class="mt-8 flex items-center gap-4 text-xs text-white dark:text-white md:text-neutral-900">
        <span class="truncate min-w-0">{post.data.tags.join(' ')}</span>
        <span class="shrink-0"><FormattedDate date={post.data.pubDate} /></span>
      </div>
      <h3 class="mt-3 text-lg text-white font-bold dark:text-white md:text-neutral-900">
        {post.data.title}
      </h3>
      <p class="hero-desc mt-3 text-white dark:text-white md:text-neutral-900">
        {post.data.description}
      </p>
    </div>
  </a>
</div>

<style>
  .hero-cover img,
  .hero-cover picture {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* 移动端单列时限制行数，宽屏下完整展示 */
  .hero-desc {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero-desc {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
      line-clamp: unset;
    }
  }
</style>
