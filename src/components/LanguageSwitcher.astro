---
import { getChineseCategory, getEnglishCategory } from '@utils/categoryMapping'
import { getChineseTag, getEnglishTag } from '@utils/tagMapping'
import { Icon } from 'astro-icon/components'

const currentLocale = Astro.currentLocale ?? 'zh'

const currentPath = Astro.url.pathname
let zhUrl, enUrl

if (currentPath.includes('/posts/') || currentPath.includes('/en/posts/')) {
  const pathParts = currentPath.split('/').filter(Boolean)
  const slug = pathParts[pathParts.length - 1]

  if (currentLocale === 'zh') {
    zhUrl = currentPath
    enUrl = `/en/posts/us/${slug}/`
  } else {
    zhUrl = `/zh/posts/cn/${slug}/`
    enUrl = currentPath
  }
} else if (currentPath.includes('/zh/category/') || currentPath.includes('/en/category/')) {
  const pathParts = currentPath.split('/').filter(Boolean)
  const category = decodeURIComponent(pathParts[pathParts.length - 2])
  const page = pathParts[pathParts.length - 1]

  if (currentLocale === 'zh') {
    zhUrl = currentPath
    const englishCategory = getEnglishCategory(category)
    enUrl = `/en/category/${encodeURIComponent(englishCategory)}/${page}/`
  } else {
    const chineseCategory = getChineseCategory(category)
    zhUrl = `/zh/category/${encodeURIComponent(chineseCategory)}/${page}/`
    enUrl = currentPath
  }
} else if (currentPath.includes('/zh/tags/') || currentPath.includes('/en/tags/')) {
  const pathParts = currentPath.split('/').filter(Boolean)

  // Check if it's a tag index page (e.g., /zh/tags/ or /en/tags/)
  if (pathParts.length === 2) {
    if (currentLocale === 'zh') {
      zhUrl = currentPath
      enUrl = `/en/tags/`
    } else {
      zhUrl = `/zh/tags/`
      enUrl = currentPath
    }
  } else {
    const tag = decodeURIComponent(pathParts[pathParts.length - 2])
    const page = pathParts[pathParts.length - 1]

    if (currentLocale === 'zh') {
      zhUrl = currentPath
      const englishTag = getEnglishTag(tag)
      enUrl = `/en/tags/${encodeURIComponent(englishTag)}/${page}/`
    } else {
      const chineseTag = getChineseTag(tag)
      zhUrl = `/zh/tags/${encodeURIComponent(chineseTag)}/${page}/`
      enUrl = currentPath
    }
  }
} else {
  if (currentLocale === 'zh') {
    zhUrl = currentPath
    enUrl = `/en${currentPath.slice(3)}`
  } else {
    zhUrl = `/zh${currentPath.slice(3)}`
    enUrl = currentPath
  }
}

const switchLanguageUrl = currentLocale === 'zh' ? enUrl : zhUrl
---

<details class="group relative inline-flex">
  <summary
    class="hs-dropdown-toggle inline-flex items-center gap-x-2 rounded-lg bg-white px-3 py-2 text-sm text-neutral-800 disabled:pointer-events-none dark:border-neutral-700 dark:bg-neutral-900 hover:bg-neutral-50 dark:text-white disabled:opacity-50 dark:hover:bg-neutral-800 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    {
      currentLocale === 'zh' ? (
        <>
          <Icon name="flagpack:cn" />
          中文
        </>
      ) : (
        <>
          <Icon name="flagpack:um" />
          English
        </>
      )
    }
    <Icon
      name="tabler:chevron-up"
      class="size-4 flex-shrink-0 text-neutral-500 transition-transform group-open:rotate-180 dark:text-neutral-500"
    />
  </summary>
  <div
    class="absolute bottom-full left-0 mb-2 w-40 rounded-lg bg-white p-2 shadow-md dark:border dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700"
  >
    <a
      class="flex items-center gap-x-2 rounded-lg px-3 py-2 text-sm text-neutral-800 hover:bg-neutral-100 dark:text-neutral-400 dark:hover:bg-neutral-700 dark:hover:text-neutral-300"
      href={switchLanguageUrl}
    >
      <Icon name={currentLocale === 'zh' ? 'flagpack:um' : 'flagpack:cn'} />
      {currentLocale === 'zh' ? 'English' : '中文'}
    </a>
  </div>
</details>
