---
import HeaderLinks from '@components/HeaderLinks.astro'
import { Icon } from 'astro-icon/components'
import { getRelativeLocaleUrl } from 'astro:i18n'

let navData

const currentLocale = Astro.currentLocale ?? 'zh'

if (currentLocale === 'zh') {
  navData = await import('@utils/zh/headernav')
} else {
  navData = await import('@utils/en/headernav')
}

const { one, two, three } = navData

function safeGetRelativeLocaleUrl(path: string) {
  return getRelativeLocaleUrl(currentLocale, path)
}

const brandName = currentLocale === 'zh' ? '无双的经验之谈' : 'PeerlessLessonsLearned'
---

<header class="z-50 w-full flex flex-wrap py-7 lg:flex-nowrap lg:justify-start">
  <nav
    class="relative mx-auto max-w-7xl w-full flex basis-full flex-wrap items-center px-4 lg:grid lg:grid-cols-12 lg:px-8"
    aria-label="Global"
  >
    <div class="lg:col-span-3">
      <a
        class="inline-block flex-none rounded-xl text-xl font-semibold dark:text-white focus:opacity-80 focus:outline-none"
        href={safeGetRelativeLocaleUrl('/')}
        aria-label="Astroverse"
      >
        {brandName}
      </a>
    </div>

    <div class="ms-auto flex items-center gap-x-2 py-1 lg:order-3 lg:col-span-3 lg:ps-6">
      <button
        type="button"
        onclick={`window.location.href='${safeGetRelativeLocaleUrl('/search/')}'`}
        class="inline-flex items-center gap-x-2 rounded-full px-3 py-2 text-sm text-black font-medium disabled:pointer-events-none dark:border-neutral-700 hover:bg-neutral-100 dark:text-white disabled:opacity-50 dark:hover:bg-white/10 dark:hover:text-white"
        aria-label="Search"
      >
        <Icon name="tabler:search" class="icon-base" />
      </button>

      <button
        type="button"
        class="hs-dark-mode inline-flex items-center gap-x-2 rounded-full px-3 py-2 text-sm text-black hs-dark-mode-active:hidden hover:bg-white/20"
        data-hs-theme-click-value="dark"
        aria-label="Light"
      >
        <Icon name="tabler:sun-filled" class="icon-base" />
      </button>
      <button
        type="button"
        class="hs-dark-mode hidden items-center gap-x-2 rounded-full px-3 py-2 text-sm text-white hs-dark-mode-active:inline-flex hover:bg-white/20"
        data-hs-theme-click-value="light"
        aria-label="Dark"
      >
        <Icon name="tabler:moon-filled" class="icon-base" />
      </button>

      <div class="lg:hidden">
        <button
          type="button"
          class="hs-collapse-toggle size-[38px] flex items-center justify-center text-sm text-black font-semibold disabled:pointer-events-none dark:border-neutral-700 hover:bg-neutral-100 dark:text-white disabled:opacity-50 dark:hover:bg-neutral-700"
          data-hs-collapse="#navbar-collapse-with-animation"
          aria-controls="navbar-collapse-with-animation"
          aria-label="Toggle navigation"
        >
          <Icon name="tabler:menu-2" class="size-4 flex-shrink-0 hs-collapse-open:hidden" />
          <Icon name="tabler:menu-order" class="hidden size-4 flex-shrink-0 hs-collapse-open:block" />
        </button>
      </div>
      <a
        type="button"
        href="https://github.com/peerless-hero/peerless-lessons-learned"
        class="inline-flex items-center gap-x-2 rounded-full px-3 py-2 text-sm text-black font-medium disabled:pointer-events-none dark:border-neutral-700 hover:bg-neutral-100 dark:text-white disabled:opacity-50 dark:hover:bg-white/10 dark:hover:text-white"
        aria-label="Github"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="octicon:mark-github-24" class="icon-base" />
      </a>
    </div>

    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 lg:order-2 lg:col-span-6 lg:block lg:w-auto lg:basis-auto"
    >
      <div
        class="mt-5 flex flex-col gap-x-0 gap-y-4 lg:mt-0 lg:flex-row lg:items-center lg:justify-center lg:gap-x-7 lg:gap-y-0"
      >
        <HeaderLinks href={safeGetRelativeLocaleUrl(one.href)}>
          {one.text}
        </HeaderLinks>
        <HeaderLinks href={safeGetRelativeLocaleUrl(two.href)}>
          {two.text}
        </HeaderLinks>
        <HeaderLinks href={safeGetRelativeLocaleUrl(three.href)}>
          {three.text}
        </HeaderLinks>
      </div>
    </div>
  </nav>
</header>
